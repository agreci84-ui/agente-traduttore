<Window x:Class="TraduttoreLive.FinestraChiaveApi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chiave API di Claude"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=Chiave}">
    <StackPanel Margin="20,16,20,18">
        <TextBlock TextWrapping="Wrap">
            Per tradurre, il programma usa Claude tramite l'API di Anthropic e gli serve una chiave API.
            Puoi crearla nella console di Claude, alla voce «API keys». L'uso dell'API si paga a consumo,
            a parte rispetto agli abbonamenti a Claude.
        </TextBlock>
        <TextBlock Margin="0,8,0,0">
            <Hyperlink NavigateUri="https://platform.claude.com/settings/keys" RequestNavigate="ApriPagina">
                Apri la pagina delle chiavi API
            </Hyperlink>
        </TextBlock>

        <TextBlock Margin="0,16,0,4" Text="Chiave API (inizia con sk-ant-):" />
        <PasswordBox x:Name="Chiave" Padding="4,5" PasswordChanged="SuModifica" />
        <TextBlock x:Name="Errore" Margin="0,4,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />

        <TextBlock Margin="0,12,0,0" Foreground="#5F6368" TextWrapping="Wrap">
            La chiave resta su questo PC, cifrata con il tuo account di Windows.
            Senza chiave il programma mostra solo la trascrizione.
        </TextBlock>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="PulsanteRimuovi" DockPanel.Dock="Left" MinWidth="110" Padding="10,4"
                    Content="Rimuovi la chiave" Click="SuRimuovi" />
            <Button DockPanel.Dock="Right" MinWidth="90" Padding="10,4" Margin="8,0,0,0"
                    Content="Annulla" IsCancel="True" />
            <Button DockPanel.Dock="Right" MinWidth="90" Padding="10,4"
                    Content="Salva" IsDefault="True" Click="SuSalva" />
        </DockPanel>
    </StackPanel>
</Window>
